# 本地开发用 .env.local 模板
# 复制此文件为 .env.local 后填入真实值

# ===== Auth.js =====
AUTH_SECRET="dev_only_secret_replace_me_in_production_long_enough"
AUTH_URL="http://localhost:3000"

# 邮件魔法链接（可选，不配也能用邮箱密码）
EMAIL_FROM=""
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=""
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# GitHub / Google OAuth（可选）
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ===== 本地 Postgres（docker-compose up -d 后使用）=====
POSTGRES_URL="postgres://readystudy:readystudy@localhost:5432/readystudy"

# ===== 本地 Redis（替代 Vercel KV）=====
# 注意：本地 Redis 不支持 Upstash REST API，
# 但 @upstash/redis SDK 同时支持原生 Redis 协议（使用 url + token = redis://...）
KV_REST_API_URL="redis://localhost:6379"
KV_REST_API_TOKEN="local_dev_no_auth"

# ===== 本地 MinIO（替代 Vercel Blob，需 docker compose --profile blob up）=====
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_dev_local"

# ===== Stripe（占位，未启用）=====
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ===== BYOK 加密密钥 =====
# 本地随便用，生产请用 openssl rand -hex 32
BYOK_ENC_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ===== 应用 =====
NEXT_PUBLIC_APP_NAME="ReadyStudy"