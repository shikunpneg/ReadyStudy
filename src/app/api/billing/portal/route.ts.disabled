/**
 * ⚠️ 已禁用。启用付费时移除 .disabled 后缀。
 *
 * POST /api/billing/portal
 *   返回 Stripe Customer Portal URL（用户管理订阅/付款方式）
 */
import { NextResponse } from 'next/server';
import { auth } from '@/lib/auth';
import { createCustomerPortal } from '@/lib/billing/stripe.server';
import { STRIPE_CONFIG } from '@/lib/billing';
import { ensureCustomer } from '@/lib/billing/stripe.server';

export const runtime = 'nodejs';

export async function POST() {
  if (!process.env.STRIPE_SECRET_KEY) {
    return NextResponse.json({ error: 'Stripe 暂未启用' }, { status: 501 });
  }
  const session = await auth();
  if (!session?.user) return NextResponse.json({ error: 'unauthorized' }, { status: 401 });

  const customer = await ensureCustomer(session.user.email!, session.user.name);
  const portal = await createCustomerPortal({
    customerId: customer.id,
    returnUrl: `${process.env.AUTH_URL}${STRIPE_CONFIG.cancelUrl}`,
  });

  return NextResponse.json({ url: portal.url });
}