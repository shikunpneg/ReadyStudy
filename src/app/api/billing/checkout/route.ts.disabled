/**
 * ⚠️ 此文件已禁用（.disabled 后缀），启用付费时移除后缀即可。
 *
 * POST /api/billing/checkout
 *   body: { priceId?: string }
 *   返回：{ url: 'https://checkout.stripe.com/...' }
 */
import { NextResponse } from 'next/server';
import { auth } from '@/lib/auth';
import {
  STRIPE_CONFIG,
  type Plan,
} from '@/lib/billing';
import {
  createCheckoutSession,
  ensureCustomer,
} from '@/lib/billing/stripe.server';

export const runtime = 'nodejs';

export async function POST(req: Request) {
  if (!process.env.STRIPE_SECRET_KEY) {
    return NextResponse.json(
      { error: 'Stripe 暂未启用' },
      { status: 501 },
    );
  }

  const session = await auth();
  if (!session?.user) return NextResponse.json({ error: 'unauthorized' }, { status: 401 });
  const userId = (session.user as { id: string }).id;
  const userEmail = session.user.email!;

  const body = (await req.json().catch(() => ({}))) as { priceId?: string };
  const priceId = body.priceId ?? STRIPE_CONFIG.proPriceId;

  const customer = await ensureCustomer(userEmail, session.user.name);
  const checkout = await createCheckoutSession({
    customerId: customer.id,
    priceId,
    userId,
    successUrl: `${process.env.AUTH_URL}${STRIPE_CONFIG.successUrl}`,
    cancelUrl: `${process.env.AUTH_URL}${STRIPE_CONFIG.cancelUrl}`,
  });

  return NextResponse.json({ url: checkout.url });
}